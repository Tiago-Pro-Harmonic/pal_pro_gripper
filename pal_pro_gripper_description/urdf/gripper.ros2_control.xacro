<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="ros2_control_pal_pro_gripper" params="name reduction sim_type:=no-simulation">

    <xacro:macro name="ros2_control_pal_pro_gripper_mimic_joint" params="mimic_joint_name actuated_joint_name multiplier sim_type:=no-simulation">

      <xacro:if value="${sim_type == 'gazebo'}">
        <!-- gz_ros2_control's software mimic controller can drive the joint
        into its own limit and never recover (unfixed DART bug on Harmonic's
        dartsim version, see
        https://github.com/ros-controls/gz_ros2_control/issues/165). Make the
        joint independently actuated in simulation instead of relying on the
        URDF mimic tag; the caller is responsible for computing and sending
        this joint's target position alongside the leader's. -->
        <joint name="${mimic_joint_name}" mimic="false">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>
      </xacro:if>
      <xacro:unless value="${sim_type == 'gazebo'}">
        <joint name="${mimic_joint_name}">
          <param name="mimic">${actuated_joint_name}</param>
          <param name="multiplier">${multiplier}</param>
          <state_interface name="position"/>
        </joint>
      </xacro:unless>

    </xacro:macro>

    <joint name="${name}_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.07938</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>


    <xacro:ros2_control_pal_pro_gripper_mimic_joint mimic_joint_name="${name}_outer_finger_right_joint" actuated_joint_name="${name}_finger_joint" multiplier="-8.28" sim_type="${sim_type}"/>

    <xacro:ros2_control_pal_pro_gripper_mimic_joint mimic_joint_name="${name}_inner_finger_right_joint" actuated_joint_name="${name}_finger_joint" multiplier="-8.28" sim_type="${sim_type}"/>

    <xacro:ros2_control_pal_pro_gripper_mimic_joint mimic_joint_name="${name}_fingertip_right_joint" actuated_joint_name="${name}_finger_joint" multiplier="8.28" sim_type="${sim_type}"/>

    <xacro:ros2_control_pal_pro_gripper_mimic_joint mimic_joint_name="${name}_finger_right_joint" actuated_joint_name="${name}_finger_joint" multiplier="0.22" sim_type="${sim_type}"/>

    <xacro:ros2_control_pal_pro_gripper_mimic_joint mimic_joint_name="${name}_outer_finger_left_joint" actuated_joint_name="${name}_finger_joint" multiplier="-8.28" sim_type="${sim_type}"/>

    <xacro:ros2_control_pal_pro_gripper_mimic_joint mimic_joint_name="${name}_inner_finger_left_joint" actuated_joint_name="${name}_finger_joint" multiplier="-8.28" sim_type="${sim_type}"/>

    <xacro:ros2_control_pal_pro_gripper_mimic_joint mimic_joint_name="${name}_fingertip_left_joint" actuated_joint_name="${name}_finger_joint" multiplier="8.28" sim_type="${sim_type}"/>

    <!-- Transmission only set to left finger joint, other joints are passive and mimic this
    joint-->
    <xacro:if value="${sim_type not in ['mujoco', 'mujoco-ros2-control']}">
      <xacro:include filename="$(find pal_pro_gripper_description)/urdf/gripper.transmission.xacro" />
      <xacro:pal_pro_gripper_transmission name="${name}_finger"/>
    </xacro:if>

  </xacro:macro>
</robot>
