<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="pal_pro_gripper">
    
    <xacro:macro name="mj_gripper_common">
      <compiler strippath="false" discardvisual="false" balanceinertia="true" angle="radian" />
        <option integrator="implicitfast" />
        
        <asset>
            <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
                height="3072" />
            <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
                rgb2="0.1 0.2 0.3"
                markrgb="0.8 0.8 0.8" width="300" height="300" />
            <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
                reflectance="0.2" />
        </asset>

        <worldbody>
            <light name="spotlight" mode="targetbody" target="base_link" pos="1 0 10" />
            <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" group="0" contype="1" conaffinity="1" friction="0.001 0.0 0.0"/>
        </worldbody>
    </xacro:macro>


    <xacro:macro name="mj_gripper_actuators" params="side reflect">
        <xacro:if value="${mj_controller == 'position' or mj_controller == 'motor'}">
            <position name="${side}_position" joint="${side}_inner_finger_left_joint" kp="100" ctrlrange=" 0 0.802851 " />
        </xacro:if>
    </xacro:macro>


    <xacro:macro name="mj_gripper_contact" params="side">
        <exclude body1="${side}_inner_finger_left_link"  body2="${side}_outer_finger_left_link"/>
        <exclude body1="${side}_fingertip_left_link"     body2="${side}_outer_finger_left_link"/>
        <exclude body1="${side}_inner_finger_right_link" body2="${side}_outer_finger_right_link"/>
        <exclude body1="${side}_fingertip_right_link"    body2="${side}_outer_finger_right_link"/>
    </xacro:macro>

    
    <xacro:macro name="mj_gripper_equality" params="side anchor_r anchor_l" >
        <connect name="${side}_r" body1="${side}_fingertip_right_link" body2="${side}_outer_finger_right_link"  active="true" anchor="${anchor_r}" solref="0.005 1" solimp="0.95 0.99 0.001"/>
        <connect name="${side}_l" body1="${side}_fingertip_left_link" body2="${side}_outer_finger_left_link" active="true"  anchor="${anchor_l}" solref="0.005 1" solimp="0.95 0.99 0.001"/>
        <joint joint1="${side}_inner_finger_left_joint" joint2="${side}_inner_finger_right_joint" polycoef="0 1 0 0 0" solref="0.005 1" solimp="0.95 0.99 0.001"/>  
    </xacro:macro>

    
</robot>