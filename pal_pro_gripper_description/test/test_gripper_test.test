<launch>
  <arg name="multi" default=""/>
  <param name="robot_description" command="rosrun xacro xacro --inorder '$(find pal_pro_gripper_description)/robots/pal_pro_gripper.urdf.xacro' $(arg multi)" />

  <include file="$(find urdf_test)/launch/test_urdf.launch">
    <arg name="get_description" value="true"/>
  </include>
</launch>
